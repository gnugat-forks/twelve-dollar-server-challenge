{
	auto_https off
	admin off

	frankenphp {
		# 3 PHP threads: the 2 workers, 1 for other scripts. Letting FrankenPHP add threads when requests wait for one
		# (max_threads 8) served fewer requests once the CPU is full (README, "On the leaderboard").
		# Worker mode: Symfony boots once per thread, then handles requests in a loop.
		# 2 workers, FrankenPHP's default on 1 CPU (2 per CPU), whatever the CPUs (CI has 4).
		# Restarted every 500 requests by public/index.php.
		worker {
			file ./public/index.php
			num 2
		}
	}
}

http://:{$PORT} {
	bind {$HOST}
	root ./public
	# An API without static files: no try_files filesystem checks, everything goes to Symfony
	rewrite * /index.php
	php
}
